# ---------------------------------------------------------------
# EcoGuard AI configuration. Copy this file to ".env" and edit it.
# The ".env" file is private: never share it or commit it.
# ---------------------------------------------------------------

# OPTIONAL: OpenRouter key for AI document analysis, narratives and regulatory explanations.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional. Leave blank for local SQLite; configure Neon in production.
DATABASE_URL=
# URL format: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# OPTIONAL: Google API key used only by the optional ChromaDB embedding backend.
# GOOGLE_API_KEY=your-google-api-key

# OPTIONAL: LangSmith tracing of LLM calls (leave false if unused)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=EcoGuard-AI

# OPTIONAL: use ChromaDB + Google embeddings for retrieval instead of the
# built-in local BM25 retriever (needs GOOGLE_API_KEY and requirements-optional.txt)
USE_VECTOR_DB=false

# Server / limits
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local filesystem by default. Set to vercel_blob on Vercel and connect a
# private Blob store; Vercel supplies BLOB_STORE_ID and OIDC credentials.
FILE_STORAGE_BACKEND=local

# Required for protected API routes. Configure from your OIDC provider.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Comma-separated OIDC subject IDs allowed to refresh sources/run evaluation.
AUTH_ADMIN_SUBJECTS=
